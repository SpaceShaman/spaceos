{
    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 9
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 100,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a %b %d, %H:%M}",
        "tooltip": false
    },

    "backlight": {
        "format": "☀ {percent}%",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "♪ {volume}%",
        "format-muted": "♪ mute",
        "tooltip": false
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}%+",
        "tooltip": false
    },

    "tray": {
        "spacing": 6
    }
}
