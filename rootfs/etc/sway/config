include /etc/sway/config.d/10-systemd-session.conf

exec --no-startup-id /etc/sway/scripts/init-gtk-theme.sh

input type:keyboard {
    xkb_layout pl
}

set $mod Mod4
set $term alacritty
mouse_warping container
floating_modifier $mod normal
tiling_drag enable

exec --no-startup-id /etc/sway/scripts/layout.sh

include config.d/theme/current.conf
include config.d/outputs.conf
include config.d/bindings.conf
include config.d/idle.conf
