input type:keyboard {
    xkb_layout pl
}

set $mod Mod4
set $term alacritty

# Ayu Dark
font sans 8
default_border pixel 1
default_floating_border pixel 1
gaps inner 0
gaps outer 0

client.focused          #B3B1AD #000000 #B3B1AD #B3B1AD #B3B1AD
client.focused_inactive #000000 #000000 #B3B1AD #000000 #000000
client.unfocused        #000000 #000000 #B3B1AD #000000 #000000
client.urgent           #F9AF4F #000000 #F9AF4F #F9AF4F #F9AF4F
client.placeholder      #000000 #000000 #B3B1AD #000000 #000000

output * bg #000000 solid_color

# Top bar: workspaces on the left, tray and system status on the right
bar {
    position top
    height 15
    font sans 10

    workspace_buttons yes
    binding_mode_indicator no
    separator_symbol " | "

    status_command /usr/libexec/spaceos-status

    tray_output *
    tray_padding 2

    colors {
        background         #000000
        statusline         #B3B1AD
        separator          #B3B1AD

        focused_workspace  #000000 #000000 #F9AF4F
        active_workspace   #000000 #000000 #B3B1AD
        inactive_workspace #000000 #000000 #B3B1AD
        urgent_workspace   #F9AF4F #F9AF4F #000000
    }
}

# Reload the configuration file
bindsym $mod+Shift+r reload

# Close focused window
bindsym $mod+q kill

# Application launcher
bindsym $mod+r exec rofi -config /etc/rofi/config.rasi -show drun

# Terminal
bindsym $mod+Return exec $term

# Browser
bindsym $mod+b exec firefox

# ChatGPT
bindsym $mod+g exec chatgpt

# Focus and move windows
bindsym $mod+a focus prev
bindsym $mod+f focus next
bindsym $mod+Shift+a move left
bindsym $mod+Shift+f move right

# Previous and next workspace. Moving a window follows it, as in AwesomeWM
bindsym $mod+s workspace prev
bindsym $mod+d workspace next
bindsym $mod+Shift+s move container to workspace prev; workspace prev
bindsym $mod+Shift+d move container to workspace next; workspace next

# Focus monitors and move windows between them
bindsym $mod+j focus output left
bindsym $mod+semicolon focus output right
bindsym $mod+l focus output up
bindsym $mod+k focus output down
bindsym $mod+Shift+j move container to output left
bindsym $mod+Shift+semicolon move container to output right
bindsym $mod+Shift+l move container to output up
bindsym $mod+Shift+k move container to output down

# Workspaces 1-9
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
