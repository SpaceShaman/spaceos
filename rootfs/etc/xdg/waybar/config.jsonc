{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": ["sway/workspaces", "sway/window"],
  "modules-right": ["tray", "network", "pulseaudio", "backlight", "battery", "clock"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "on-update": "/etc/spaceos/rootfs/etc/sway/config.d/workspace.sh normalize"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 70,
    "separate-outputs": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰤭 Offline",
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "interval": 30
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "󰃠 {percent}%"
  },
  "battery": {
    "bat": "BAT0",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "clock": {
    "format": "{0:%d.%m.%Y} {0:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
  }
}
