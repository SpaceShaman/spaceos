{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": ["sway/workspaces", "sway/window"],
  "modules-right": [
    "custom/spaceos-update",
    "tray",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "battery",
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "on-update": "/etc/sway/scripts/workspace.sh normalize"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 70,
    "separate-outputs": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "bluetooth": {
    "format-on": "",
    "format-off": "󰂲",
    "format-connected": " {device_alias}",
    "tooltip-format-connected": "{device_alias} · 󰁹 {device_battery_percentage}%",
    "tooltip-format-enumerate-connected": "{device_alias} · 󰁹 {device_battery_percentage}%",
    "on-click": "alacritty -e bluetui"
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰤭 Offline",
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "interval": 30,
    "on-click": "alacritty -e wlctl"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "alacritty -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 50%",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "󰃠 {percent}%",
    "on-click": "brightnessctl -q -d intel_backlight set 50%",
  },
  "battery": {
    "bat": "BAT0",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "custom/spaceos-update": {
    "exec": "/usr/libexec/spaceos-update-waybar",
    "return-type": "json",
    "interval": 60,
    "tooltip": true
  },
  "clock": {
    "timezone": "Europe/Warsaw",
    "format": "{0:%d.%m.%Y} {0:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
            "today": "<span color='#F9AF4F'><b><u>{}</u></b></span>"
        }
    },
    "actions": {
        "on-click": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    }
  }
}
