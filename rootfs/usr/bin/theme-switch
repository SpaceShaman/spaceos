#!/bin/sh

set -eu

case "$(readlink /etc/alacritty/themes/current.toml)" in
    dark.toml)
        theme=light
        color_scheme=prefer-light
        gtk_theme=Ayu-Light
        ;;
    *)
        theme=dark
        color_scheme=prefer-dark
        gtk_theme=Ayu-Dark
        ;;
esac

ln -sfn "$theme.toml" /etc/alacritty/themes/current.toml
ln -sfn "$theme.conf" /etc/sway/config.d/theme/current.conf
ln -sfn "themes/$theme.conf" /etc/mako/config
ln -sfn "theme-$theme.css" /etc/xdg/waybar/theme-current.css
ln -sfn "$theme.rasi" /etc/rofi/themes/current.rasi
ln -sfn "/usr/share/themes/$gtk_theme/gtk-4.0/colors.css" /etc/xdg/gtk-4.0/current.css
touch /etc/alacritty/alacritty.toml /etc/xdg/waybar/style.css

gsettings set org.gnome.desktop.interface color-scheme "$color_scheme"
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"

GTK_THEME=$gtk_theme dbus-update-activation-environment --systemd GTK_THEME

if command -v makoctl >/dev/null 2>&1; then
    makoctl reload || :
fi

if [ -S "${SWAYSOCK:-}" ]; then
    swaymsg reload >/dev/null
else
    for socket in "/run/user/${SUDO_UID:-$(id -u)}"/sway-ipc.*.sock; do
        [ -S "$socket" ] && swaymsg -s "$socket" reload >/dev/null
    done
fi

printf 'Theme changed to %s\n' "$theme"
