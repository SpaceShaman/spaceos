#!/bin/sh

set -eu

case "$(readlink /etc/alacritty/themes/current.toml)" in
    dark.toml) theme=light ;;
    *)         theme=dark ;;
esac

ln -sfn "$theme.toml" /etc/alacritty/themes/current.toml
ln -sfn "$theme.conf" /etc/sway/config.d/theme/current.conf
ln -sfn "theme-$theme.css" /etc/xdg/waybar/theme-current.css
touch /etc/alacritty/alacritty.toml /etc/xdg/waybar/style.css

if [ -S "${SWAYSOCK:-}" ]; then
    swaymsg reload >/dev/null
else
    for socket in "/run/user/${SUDO_UID:-$(id -u)}"/sway-ipc.*.sock; do
        [ -S "$socket" ] && swaymsg -s "$socket" reload >/dev/null
    done
fi

printf 'Theme changed to %s\n' "$theme"
